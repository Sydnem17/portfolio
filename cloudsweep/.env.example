# ── Required ────────────────────────────────────────────────────────────────
# Public URL of the site (no trailing slash). Used to build OAuth redirect URIs.
APP_URL=http://localhost:3100
# Password to sign in to CloudSweep. Use a long passphrase.
APP_PASSWORD=change-me-to-a-long-passphrase
# 32+ random characters. Signs sessions and encrypts stored OAuth tokens.
#   Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET=

# ── Database ────────────────────────────────────────────────────────────────
# Hosted Postgres (Neon, Supabase, Vercel Postgres...). Leave empty for local dev:
# an embedded Postgres (PGlite) is stored in ./.data instead.
DATABASE_URL=

# ── Google Drive (personal + work accounts) ─────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Microsoft OneDrive (personal + work/school) ─────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Dropbox (optional) ──────────────────────────────────────────────────────
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# ── Photo intelligence (optional) ───────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Scheduled background processing (optional) ─────────────────────────────
# Secret your scheduler sends as "Authorization: Bearer <CRON_SECRET>" to /api/cron.
CRON_SECRET=
